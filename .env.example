# ------------------------------------------------------------------
# Supabase
# ------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Yalnızca sunucu tarafında kullanılır (admin işlemleri). Asla client'a sızdırılmaz.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ------------------------------------------------------------------
# Resend (E-posta gönderimi)
# ------------------------------------------------------------------
RESEND_API_KEY=your-resend-api-key
RESEND_FROM_EMAIL=noreply@alanadim.com

# ------------------------------------------------------------------
# Uygulama
# ------------------------------------------------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Admin e-postaları (virgülle ayrılır). Bu e-postalarla giriş yapan
# kullanıcılar admin paneline erişir.
ADMIN_EMAILS=admin@alanadim.com
